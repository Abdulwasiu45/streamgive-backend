generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  previewFeatures = ["driverAdapters", "queryCompiler"]
  engineType = "client"

  // Pinned rather than inferred. Prisma decides this from the surrounding
  // project when it is not set, and the Docker build runs `prisma generate`
  // during `npm ci` - before tsconfig.json has been copied in - so it
  // guessed .ts there and .js locally. tsc copies specifiers through
  // verbatim, so the image ended up importing .ts files that do not exist
  // in dist/ and crashed on boot with ERR_MODULE_NOT_FOUND.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Donor {
  id        String   @id @default(uuid())
  address   String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  streams   Stream[]

  @@map("donors")
}

model Ngo {
  id           String   @id @default(uuid())
  ownerAddress String   @unique @map("owner_address")
  name         String
  displayName  String?  @map("display_name")
  verified     Boolean  @default(false)
  /// When the registry last approved this NGO; null while unverified.
  verifiedAt       DateTime? @map("verified_at")
  /// When the registry's verification expires; null when it has no expiry. Past this instant the NGO counts as unverified.
  verifiedUntil    DateTime? @map("verified_until")
  /// Owner-updated public description; falls back to approved application when null.
  description      String?
  /// Owner-updated public website; falls back to approved application when null.
  website          String?
  /// Timestamp of the last owner-initiated profile update.
  profileUpdatedAt DateTime? @map("profile_updated_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  streams      Stream[]

  @@index([createdAt])
  @@index([verified])
  @@map("ngos")
}

enum StreamStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Stream {
  id            String       @id @default(uuid())
  /// Stream id as assigned by the donation-vault contract.
  onChainId     BigInt       @unique @map("on_chain_id")
  donorId       String       @map("donor_id")
  donor         Donor        @relation(fields: [donorId], references: [id])
  ngoId         String       @map("ngo_id")
  ngo           Ngo          @relation(fields: [ngoId], references: [id])
  tokenAddress  String       @map("token_address")
  /// i128 values from the contract, stored as decimal strings to avoid
  /// precision loss — Postgres bigint/numeric mapping is handled at the
  /// application layer, not by Prisma's native int types.
  rate          String
  lastRate      String?      @map("last_rate")
  balance       String
  withdrawn     String
  status        StreamStatus @default(ACTIVE)
  /// Set after the one-time stream_running_low notification is queued.
  runningLowNotifiedAt DateTime? @map("running_low_notified_at")
  /// Transaction hash of the on-chain transaction that created this stream.
  /// Null for streams indexed before this field was added.
  createdTxHash String?      @map("created_tx_hash")
  /// Short memo the donor attached to the stream; null when none was given.
  memo          String?
  /// When the stream starts, for a delayed start; null when it started at creation.
  startsAt      DateTime?    @map("starts_at")
  /// When the donor paused the stream; null unless the status is PAUSED.
  pausedAt      DateTime?    @map("paused_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([donorId])
  @@index([ngoId])
  @@index([createdAt])
  @@index([status])
  @@index([status, runningLowNotifiedAt])
  @@index([tokenAddress])
  @@index([ngoId, createdAt])
  @@map("streams")
}

enum NgoApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Off-chain intake for prospective NGOs, reviewed by admins
/// before anyone goes and calls the on-chain `approve_ngo`. Deliberately
/// separate from `Ngo.verified`: this tracks the review workflow, while
/// `Ngo.verified` stays sourced only from the contract's `approved` event
/// (handled by the indexer) so there's exactly one source of truth for
/// on-chain state.
model NgoApplication {
  id                            String               @id @default(uuid())
  ownerAddress                  String               @map("owner_address")
  name                          String
  description                   String
  website                       String?
  contactEmail                  String               @map("contact_email")
  country                       String?
  /// Applicant's preferred language (BCP 47 tag), used to pick an email template; null means English.
  locale                        String?
  status                        NgoApplicationStatus @default(PENDING)
  reviewNote                    String?              @map("review_note")
  reviewedBy                    String?              @map("reviewed_by")
  reviewedAt                    DateTime?            @map("reviewed_at")
  emailVerifiedAt               DateTime?            @map("email_verified_at")
  lastContactVerificationSentAt DateTime?             @map("last_contact_verification_sent_at")
  createdAt                     DateTime             @default(now()) @map("created_at")
  updatedAt                     DateTime             @updatedAt @map("updated_at")
  contactEmailChallenge NgoApplicationContactChallenge?

  @@index([ownerAddress])
  @@index([status])
  @@index([createdAt])
  @@map("ngo_applications")
}

/// Stored result of a write made with an `Idempotency-Key` header, so a client
/// retrying after a timeout gets the original response instead of a duplicate.
/// `statusCode` is null while the first request is still being processed.
model IdempotencyRecord {
  /// `<scope>:<client key>`, e.g. `ngo-applications:3f1c...`.
  key         String   @id
  /// SHA-256 of the request body, to detect a key reused with a different body.
  requestHash String   @map("request_hash")
  statusCode  Int?     @map("status_code")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_records")
}

model NgoApplicationContactChallenge {
  tokenHash     String         @id @map("token_hash")
  applicationId String         @unique @map("application_id")
  expiresAt     DateTime       @map("expires_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  application   NgoApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("ngo_application_contact_challenges")
}

model NgoApplicationChallenge {
  challenge    String   @id
  ownerAddress String   @map("owner_address")
  expiresAt    DateTime @map("expires_at")

  @@index([ownerAddress, expiresAt])
  @@map("ngo_application_challenges")
}

model NotificationLog {
  id        String   @id @default(uuid())
  eventId   String?  @map("event_id")
  eventType String   @map("event_type")
  channel   String
  success   Boolean
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, channel])
  @@map("notification_logs")
}

/// Immutable record of a successful signed-admin mutation. Summaries are
/// deliberately written without request bodies so secrets and sensitive
/// submitted values are never copied into the audit trail.
model AdminAuditLog {
  id           String   @id @default(uuid())
  adminAddress String   @map("admin_address")
  action       String
  targetId     String   @map("target_id")
  summary      String   @db.VarChar(240)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt, id])
  @@index([adminAddress, createdAt])
  @@index([action, createdAt])
  @@index([targetId, createdAt])
  @@map("admin_audit_logs")
}

/// Configured webhook destinations. Event names are stored as strings so a
/// deployment can add event types without a database enum migration.
model NotificationEndpoint {
  id         String   @id @default(uuid())
  url        String
  secret     String
  /// Secret replaced by the last rotation. Until `previousSecretExpiresAt`, deliveries also carry a signature made with it.
  previousSecret          String?   @map("previous_secret")
  previousSecretExpiresAt DateTime? @map("previous_secret_expires_at")
  eventTypes String[] @default([]) @map("event_types")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([enabled])
  @@map("notification_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Durable per-destination webhook attempts. The URL and secret are snapshotted
/// when queued so retries remain possible if an endpoint is later edited or deleted.
model WebhookDelivery {
  id            String                @id @default(uuid())
  deliveryKey   String                @unique @map("delivery_key")
  eventId       String?               @map("event_id")
  eventType     String                @map("event_type")
  channel       String
  url           String
  secret        String?
  previousSecret          String?   @map("previous_secret")
  previousSecretExpiresAt DateTime? @map("previous_secret_expires_at")
  payload       String
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  maxAttempts   Int                   @default(5) @map("max_attempts")
  nextAttemptAt DateTime              @default(now()) @map("next_attempt_at")
  lockedUntil   DateTime?             @map("locked_until")
  lastError     String?               @map("last_error")
  completedAt   DateTime?             @map("completed_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([lockedUntil])
  @@map("webhook_deliveries")
}

/// Single-row-per-id table tracking how far the event indexer has gotten,
/// so a restart resumes instead of re-scanning from "now" every time.
model IndexerCheckpoint {
  id          String   @id
  lastLedger  Int      @map("last_ledger")
  lastEventId String?  @map("last_event_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("indexer_checkpoints")
}

/// Events the indexer could not decode or handle. Recording one is what
/// lets the checkpoint advance past it: before this table existed a single
/// event whose shape didn't match the handler's expectations threw on every
/// poll, pinning the checkpoint and blocking every later event behind it
/// forever. Nothing reads these rows automatically — they exist so a failure
/// is inspectable and replayable by hand instead of silently dropped.
model IndexerDeadLetter {
  id             String    @id @default(uuid())
  /// Event id as assigned by the RPC ("<ledger>-<index>"), unique per event.
  eventId        String    @unique @map("event_id")
  ledger         Int
  contractId     String?   @map("contract_id")
  /// The handler's failure message, for diagnosing the shape mismatch.
  error          String
  /// Raw topic ScVals encoded as base64 XDR strings.
  topic          String[]  @default([])
  /// Raw value ScVal encoded as base64 XDR string.
  value          String?
  /// Transaction hash that contained the event.
  txHash         String?   @map("tx_hash")
  /// Number of times processing this event has been attempted.
  attempts       Int       @default(1)
  /// Timestamp when the dead letter was resolved or replayed.
  resolvedAt     DateTime? @map("resolved_at")
  /// Admin address that marked this event resolved.
  resolvedBy String?   @map("resolved_by")
  /// Optional operator note describing the resolution.
  resolutionNote String? @map("resolution_note")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([ledger])
  @@map("indexer_dead_letters")
}

/// Immutable audit log of every on-chain contract event the indexer has
/// processed. One row per event, written in the same transaction as the
/// state update it triggered. Enables activity feeds, balance-drift
/// debugging, and idempotent reprocessing.
model StreamEvent {
  id        String   @id @default(uuid())
  /// Discriminator matching the contract topic: "created" | "withdraw" |
  /// "cancel" | "register" | "approved" | "revoked".
  type      String
  /// On-chain stream id (donation-vault events); null for registry events.
  streamId  BigInt?  @map("stream_id")
  /// Ledger sequence number the event was included in.
  ledger    Int
  /// Transaction hash that contained the event.
  txHash    String   @map("tx_hash")
  /// Full event payload serialised to JSON for auditing and replay.
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([streamId])
  @@index([streamId, createdAt])
  @@index([type])
  @@index([ledger])
  @@map("stream_events")
}

/// An email address a donor registered for alerts about their streams. Alerts go only to rows
/// with `verifiedAt` set. `unsubscribeToken` is the secret in every email's one click
/// unsubscribe link; `verificationTokenHash` is the SHA-256 of the one-time confirmation token.
model DonorEmailAlert {
  id                     String    @id @default(uuid())
  donorAddress           String    @map("donor_address")
  email                  String
  verificationTokenHash  String?   @unique @map("verification_token_hash")
  verificationExpiresAt  DateTime? @map("verification_expires_at")
  lastVerificationSentAt DateTime? @map("last_verification_sent_at")
  verifiedAt             DateTime? @map("verified_at")
  unsubscribeToken       String    @unique @map("unsubscribe_token")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@unique([donorAddress, email])
  @@index([donorAddress])
  @@map("donor_email_alerts")
}
